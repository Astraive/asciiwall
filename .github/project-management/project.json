  "derived_labels": [
    {
      "name": "path:critical",
      "source": "effort-weighted longest hard-dependency chain; estimates not dates",
      "meaning": "One deterministic maximum-weight chain in the acyclic hard-blocker graph; atomic own effort totals 85 engineering days, containers contribute zero. This is a planning lower bound, not a schedule."
    }
  ],
  "api_capabilities": {
    "create_update_views": "The observed createProjectV2View input accepts name, layout and configuration; filter is supplied by a separate updateProjectV2View mutation and then independently refetched.",
    "configuration_fields": [
      "visibleFieldIds"
    ],
    "view_read_fields": [
      "layout",
      "groupByFields",
      "verticalGroupByFields",
      "sortByFields"
    ],
    "filter": "updateProjectV2View exposes filter. The configuration tool attempts the static label/status filters only on authorized apply and records exact refetch failures; custom Blocked-field filtering is not inferred.",
    "custom_field_types": [
      "TEXT",
      "SINGLE_SELECT",
      "MULTI_SELECT",
      "NUMBER",
      "DATE",
      "ITERATION"
    ],
    "grouping": "GraphQL exposes groupByFields, verticalGroupByFields, and ordered sortByFields for view reads, but no grouping or sorting setter exists in the observed API schema. For TABLE_LAYOUT, groupByFields is primary and verticalGroupByFields must be empty; for BOARD_LAYOUT, verticalGroupByFields is primary and groupByFields is secondary. Slice by has no public API read or write field and requires manual UI verification.",
    "roadmap_dates": "No start/end, due dates, DATE fields or ITERATION fields are present. Milestone Roadmap uses TABLE_LAYOUT until real schedule data exists; no dates are invented."
  }
